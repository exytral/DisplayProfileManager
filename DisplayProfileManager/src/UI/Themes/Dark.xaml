<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Base Colors -->
    <Color x:Key="BackgroundColor">#202020</Color>
    <Color x:Key="SurfaceColor">#2B2B2B</Color>
    <Color x:Key="BorderColor">#333333</Color>
    <Color x:Key="HoverColor">#383838</Color>
    <Color x:Key="AccentColor">#0078D4</Color>

    <!-- System Accent -->
    <SolidColorBrush x:Key="SystemAccentBrush" Color="{DynamicResource {x:Static SystemColors.AccentColorKey}}"/>

    <!-- Window Backgrounds -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="AlternateBackgroundBrush" Color="#1C1C1C"/>

    <!-- Content & Control Backgrounds -->
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="TextBoxBackgroundBrush" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="ComboBoxBackgroundBrush" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="ComboBoxDropDownBackgroundBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="CheckBoxBackgroundBrush" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="ListItemBackgroundBrush" Color="{StaticResource SurfaceColor}"/>

    <!-- Borders & Separators -->
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#464647"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#4E4E4E"/>
    <SolidColorBrush x:Key="TextBoxBorderBrush" Color="#4E4E4E"/>
    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#4E4E4E"/>
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="#4E4E4E"/>
    <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="#4E4E4E"/>
    <SolidColorBrush x:Key="WindowControlHoverBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="ListItemSelectedBackgroundBrush" Color="#303030"/>
    <SolidColorBrush x:Key="ListItemSelectedHoverBackgroundBrush" Color="#454545"/>

    <!-- Interaction States -->
    <SolidColorBrush x:Key="ControlHoverBackgroundBrush" Color="{StaticResource HoverColor}"/>
    <SolidColorBrush x:Key="ListItemHoverBackgroundBrush" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="ComboBoxHoverBackgroundBrush" Color="{StaticResource HoverColor}"/>
    <SolidColorBrush x:Key="ControlPressedBackgroundBrush" Color="#2C2C2C"/>
    <SolidColorBrush x:Key="SecondaryButtonHoverBackgroundBrush" Color="#3D3D3D"/>
    <SolidColorBrush x:Key="SecondaryButtonPressedBackgroundBrush" Color="#2C2C2C"/>

    <!-- Primary Button (Accent) -->
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{DynamicResource {x:Static SystemColors.AccentColorKey}}"/>
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="White"/>
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{DynamicResource {x:Static SystemColors.AccentColorLight1Key}}"/>
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{DynamicResource {x:Static SystemColors.AccentColorKey}}"/>
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{DynamicResource {x:Static SystemColors.AccentColorKey}}"/>
    <SolidColorBrush x:Key="TextBoxFocusBorderBrush" Color="{DynamicResource {x:Static SystemColors.AccentColorKey}}"/>
    <SolidColorBrush x:Key="CheckBoxCheckmarkBrush" Color="{DynamicResource {x:Static SystemColors.AccentColorKey}}"/>
    <SolidColorBrush x:Key="LinkBrush" Color="{DynamicResource {x:Static SystemColors.AccentColorLight2Key}}"/>

    <!-- Secondary Button -->
    <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="#333333"/>
    <SolidColorBrush x:Key="SecondaryButtonForegroundBrush" Color="#FFFFFF"/>

    <!-- Status Buttons -->
    <SolidColorBrush x:Key="DangerButtonBackgroundBrush" Color="#CD212F"/>
    <SolidColorBrush x:Key="DangerButtonHoverBackgroundBrush" Color="#A81826"/>
    <SolidColorBrush x:Key="SuccessButtonBackgroundBrush" Color="#0E7C0E"/>
    <SolidColorBrush x:Key="SuccessButtonHoverBackgroundBrush" Color="#14A814"/>

    <!-- Title Bar Extras -->
    <SolidColorBrush x:Key="TitleBarTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CloseButtonHoverBrush" Color="#E81123"/>

    <!-- Text Brushes -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#C5C5C5"/>
    <SolidColorBrush x:Key="TertiaryTextBrush" Color="#8B8B8B"/>

    <!-- Tooltips -->
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="#424245"/>
    <SolidColorBrush x:Key="TooltipTextBrush" Color="#FFFFFF"/>

    <!-- Effects -->
    <DropShadowEffect x:Key="CardShadow" ShadowDepth="2" Direction="270" BlurRadius="8" Opacity="0.3" Color="Black"/>
    <DropShadowEffect x:Key="ButtonShadow" ShadowDepth="1" Direction="270" BlurRadius="4" Opacity="0.2" Color="Black"/>

</ResourceDictionary>