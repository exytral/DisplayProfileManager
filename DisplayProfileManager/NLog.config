<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Info"
      internalLogFile="${specialfolder:folder=ApplicationData}/DisplayProfileManager/Logs/nlog-internal.log">

	<!-- Define log file variables -->
	<variable name="logDirectory" value="${specialfolder:folder=ApplicationData}/DisplayProfileManager/Logs"/>
	<variable name="evidenceDirectory" value="${logDirectory}/Evidence"/>

	<!-- Define targets -->
	<!-- File target for all logs — maxArchiveDays deletes files older than 30 days on startup -->
	<targets>
		<target xsi:type="File"
				name="logfile"
				fileName="${logDirectory}/DisplayProfileManager-${shortdate}.log"
				layout="${longdate}|${level:uppercase=true}|${logger}|${message}${onexception:${newline}${exception:format=tostring}}"
				archiveFileName="${logDirectory}/DisplayProfileManager-{#}.log"
				archiveEvery="Day"
				archiveNumbering="Date"
				archiveDateFormat="yyyy-MM-dd"
				maxArchiveDays="30"
				concurrentWrites="true"
				keepFileOpen="false"
				encoding="utf-8" />

		<target xsi:type="File"
				name="evidenceFile"
				fileName="${evidenceDirectory}/DisplayEvents-${shortdate}.log"
				layout="${longdate}|${level:uppercase=true}|${logger}|${message}"
				archiveFileName="${evidenceDirectory}/DisplayEvents-{#}.log"
				archiveEvery="Day"
				archiveNumbering="Date"
				archiveDateFormat="yyyy-MM-dd"
				maxArchiveDays="7"
				concurrentWrites="true"
				keepFileOpen="false"
				encoding="utf-8" />

		<!-- Console target for debug output -->
		<target xsi:type="Console"
				name="console"
				layout="${time}|${level:uppercase=true}|${logger:shortName=true}|${message}${onexception:${newline}${exception:format=message}}" />

		<!-- Colored console target -->
		<target xsi:type="ColoredConsole"
				name="coloredConsole"
				layout="${time}|${level:uppercase=true}|${logger:shortName=true}|${message}${onexception:${newline}${exception:format=message}}"
				useDefaultRowHighlightingRules="true" />
	</targets>

	<!-- Define rules -->
	<rules>
		<logger name="DisplayProfileManager.DisplayEventEvidence" minlevel="Trace" writeTo="evidenceFile" final="true" />

		<!-- All ordinary logs to file -->
		<logger name="*" minlevel="Trace" writeTo="logfile" />

		<!-- All ordinary logs to console -->
		<logger name="*" minlevel="Trace" writeTo="coloredConsole" />
	</rules>
</nlog>
