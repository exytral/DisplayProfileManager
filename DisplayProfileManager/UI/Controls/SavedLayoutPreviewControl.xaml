<UserControl x:Class="DisplayProfileManager.UI.Controls.SavedLayoutPreviewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False"
             AutomationProperties.Name="Saved display layout">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="DiagramBorder"
                Grid.Row="0"
                Height="168"
                HorizontalAlignment="Stretch"
                BorderThickness="1"
                CornerRadius="4"
                SizeChanged="DiagramBorder_SizeChanged">
            <Canvas x:Name="LayoutCanvas"
                    ClipToBounds="True"
                    IsHitTestVisible="False"/>
        </Border>

        <TextBlock x:Name="SummaryTextBlock"
                   Grid.Row="1"
                   Margin="0,6,0,0"
                   FontSize="12"
                   TextWrapping="Wrap"/>
    </Grid>
</UserControl>
