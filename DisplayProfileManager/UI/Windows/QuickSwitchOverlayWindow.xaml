<Window x:Class="DisplayProfileManager.UI.Windows.QuickSwitchOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:presentation="clr-namespace:DisplayProfileManager.UI.Presentation"
        Title="Quick Switch"
        Width="360"
        SizeToContent="Height"
        MaxHeight="600"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStyle="None"
        AllowsTransparency="False"
        WindowStartupLocation="Manual"
        Background="{DynamicResource WindowBackgroundBrush}"
        Opacity="0"
        PreviewKeyDown="Window_PreviewKeyDown"
        Deactivated="Window_Deactivated">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="QuickSwitchOverlayResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="BackdropHost"
            Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Margin="4,2,4,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Quick Switch"
                           FontSize="18"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                <ItemsControl x:Name="HotkeyPanel"
                              Grid.Column="1"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Right">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource ControlBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Padding="5,2"
                                    Margin="2,0,0,0"
                                    MinWidth="22"
                                    AutomationProperties.Name="{Binding Label}">
                                <Grid>
                                    <TextBlock x:Name="KeyLabel"
                                               Text="{Binding Label}"
                                               FontSize="10"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               HorizontalAlignment="Center"/>
                                    <Grid x:Name="WindowsMark"
                                          Width="11"
                                          Height="11"
                                          Visibility="Collapsed">
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Rectangle Grid.Row="0" Grid.Column="0" Fill="{DynamicResource PrimaryTextBrush}" Margin="0,0,0.75,0.75"/>
                                        <Rectangle Grid.Row="0" Grid.Column="1" Fill="{DynamicResource PrimaryTextBrush}" Margin="0.75,0,0,0.75"/>
                                        <Rectangle Grid.Row="1" Grid.Column="0" Fill="{DynamicResource PrimaryTextBrush}" Margin="0,0.75,0.75,0"/>
                                        <Rectangle Grid.Row="1" Grid.Column="1" Fill="{DynamicResource PrimaryTextBrush}" Margin="0.75,0.75,0,0"/>
                                    </Grid>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsWindowsModifier}" Value="True">
                                    <Setter TargetName="KeyLabel" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="WindowsMark" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </Grid>

            <ListBox x:Name="ProfileList"
                     Grid.Row="1"
                     MaxHeight="486"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.CanContentScroll="True"
                     SelectionChanged="ProfileList_SelectionChanged"
                     PreviewMouseLeftButtonUp="ProfileList_PreviewMouseLeftButtonUp">
                <ListBox.Template>
                    <ControlTemplate TargetType="ListBox">
                        <ScrollViewer x:Name="PART_ScrollViewer"
                                      Style="{StaticResource OverlayScrollViewerStyle}"
                                      presentation:SmoothScrollBehavior.IsEnabled="True"
                                      Padding="0,0,12,0"
                                      Margin="0,0,-12,0"
                                      Focusable="False"
                                      Background="Transparent"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto"
                                      CanContentScroll="True">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBox.ItemContainerStyle>
                    <StaticResource ResourceKey="QuickSwitchItemContainerStyle"/>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid MinHeight="28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Source="{Binding LayoutIcon}"
                                   Width="22"
                                   Height="22"
                                   Stretch="Uniform"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                            <Grid x:Name="ProfileNameRegion" Grid.Column="1" Margin="6,0,4,0">
                                <Grid HorizontalAlignment="Left"
                                      MaxWidth="{Binding ActualWidth, ElementName=ProfileNameRegion}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Image Grid.Column="1"
                                           Source="{Binding CustomIcon}"
                                           Width="16"
                                           Height="16"
                                           Stretch="Uniform"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <Trigger Property="Source" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                </Grid>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Button x:Name="OpenDpmButton"
                    Grid.Row="2"
                    Style="{StaticResource QuickSwitchFooterButtonStyle}"
                    Margin="0,8,0,0"
                    Click="OpenDpmButton_Click"
                    AutomationProperties.Name="Open Display Profile Manager">
                <StackPanel Orientation="Horizontal">
                    <Image x:Name="FooterIcon"
                           Width="16"
                           Height="16"
                           Stretch="Uniform"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"/>
                    <TextBlock Text="Open Display Profile Manager"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                        <Setter Property="TextDecorations" Value="Underline"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                        <Setter Property="TextDecorations" Value="Underline"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Button>
        </Grid>
    </Border>
</Window>
